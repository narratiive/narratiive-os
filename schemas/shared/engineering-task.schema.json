{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narratiive.dev/schemas/engineering-task.schema.json",
  "title": "EngineeringTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "workspace_id",
    "repository",
    "title",
    "problem",
    "scope",
    "non_goals",
    "acceptance_criteria",
    "verification",
    "implementation_agent"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}

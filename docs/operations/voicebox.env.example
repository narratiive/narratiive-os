# Voicebox is optional and disabled unless this flag is explicitly enabled.
NARRATIIVE_VOICEBOX_ENABLED=false
NARRATIIVE_VOICEBOX_URL=http://127.0.0.1:17493
NARRATIIVE_VOICEBOX_TIMEOUT_SECONDS=10
NARRATIIVE_VOICEBOX_CLIENT_ID=narratiive-os

# Configure these after creating a consented local voice profile in Voicebox.
NARRATIIVE_VOICEBOX_PROFILE=
NARRATIIVE_VOICEBOX_ENGINE=qwen

# Keep false. Remote use requires an authenticated HTTPS reverse proxy because
# Voicebox's upstream REST and MCP endpoints do not currently authenticate.
NARRATIIVE_VOICEBOX_ALLOW_REMOTE=false
# NARRATIIVE_VOICEBOX_BEARER_TOKEN=replace-with-a-reverse-proxy-token
NARRATIIVE_VOICEBOX_MAX_DOWNLOAD_BYTES=104857600

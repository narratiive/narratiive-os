{
  "schema_version": "1.0.0",
  "template_id": "sketchbook-rave-canonical-five-page-v1",
  "status": "candidate_internal_review",
  "product": "SKETCHBOOK",
  "client_example": "Rave Coffee",
  "human_approval": "required_before_client_or_production_use",
  "canvas": {
    "width_px": 1280,
    "height_px": 720,
    "aspect_ratio": "16:9",
    "safe_margin_px": 58,
    "footer_top_px": 676,
    "grid": {
      "columns": 12,
      "gutter_px": 20,
      "column_width_px": 80,
      "baseline_px": 8
    }
  },
  "design_tokens": {
    "colours": {
      "rave_yellow": "#FFC700",
      "ink": "#17130F",
      "warm_cream": "#FAF5F0",
      "roast": "#6B351F",
      "white": "#FFFFFF",
      "pale_rule": "#E9E0D2",
      "muted_text": "#726A61"
    },
    "typeface": "Arial",
    "type_hierarchy_px": {
      "display": { "min": 46, "max": 72, "weight": 700 },
      "title": { "min": 42, "max": 50, "weight": 700 },
      "subhead": { "min": 24, "max": 34, "weight": 700 },
      "body": { "min": 18, "max": 24, "weight": 400 },
      "label": { "min": 9, "max": 12, "weight": 700 }
    }
  },
  "global_rules": {
    "rave_yellow_required": true,
    "one_dominant_idea_per_page": true,
    "maximum_primary_text_blocks": 5,
    "footer_required": true,
    "speaker_notes_provenance_required": true,
    "evidence_label_required_for_claims": true,
    "brand_logo_required": false,
    "forbidden_visual_cliches": [
      "hessian",
      "coffee_cherries",
      "latte_art",
      "moody_roastery",
      "barista_theatre",
      "cold_blue_luxury",
      "heritage_brown_overload"
    ]
  },
  "page_types": [
    {
      "id": "creative_proposition",
      "required_fields": ["proposition_line_1", "proposition_line_2", "emotional_payoff", "source_label"],
      "optional_fields": ["hero_image", "supporting_rule"],
      "geometry_px": {
        "content_panel": [0, 0, 760, 720],
        "eyebrow": [58, 38, 690, 19],
        "headline": [58, 104, 610, 362],
        "payoff": [58, 532, 610, 104],
        "image": [0, 0, 1280, 720]
      },
      "text_constraints": {
        "proposition_line_1_max_chars": 18,
        "proposition_line_2_max_chars": 18,
        "emotional_payoff_max_chars": 125
      },
      "image_rules": {
        "minimum_px": [1600, 900],
        "crop": "cover",
        "focal_area": "right_45_percent",
        "must_be_domestic_not_cafe": true
      },
      "approved_variants": ["dark_left_panel", "yellow_full_bleed_type"],
      "overflow": "reduce display type to 46px; if still over, fail validation",
      "missing_content": "fail when proposition or evidence label is missing"
    },
    {
      "id": "audience_profile",
      "required_fields": ["audience_name", "human_truth", "wants", "hesitates", "moves_when", "validation_status", "portrait"],
      "optional_fields": ["verified_quote"],
      "geometry_px": {
        "copy_panel": [0, 0, 760, 720],
        "portrait": [710, 0, 570, 720],
        "headline": [58, 98, 620, 154],
        "profile_rows": [58, 314, 598, 274],
        "validation_badge": [886, 570, 304, 70]
      },
      "text_constraints": {
        "audience_name_max_chars": 28,
        "human_truth_max_chars": 70,
        "row_max_chars": 110
      },
      "image_rules": {
        "minimum_px": [900, 1200],
        "crop": "cover",
        "focal_area": "right_half_subject",
        "portrayal": "natural domestic context; no staged product endorsement"
      },
      "approved_variants": ["portrait_right", "portrait_left"],
      "overflow": "reduce body type no lower than 18px; otherwise fail",
      "missing_content": "show NEEDS VALIDATION for unverified audience fields; never infer a quote"
    },
    {
      "id": "visual_world",
      "required_fields": ["art_direction_statement", "hero_reference", "lived_in_rule", "legibility_rule", "avoid_list", "palette"],
      "optional_fields": ["secondary_reference"],
      "geometry_px": {
        "hero_image": [0, 0, 1280, 460],
        "title": [58, 104, 720, 74],
        "rules_band": [0, 460, 1280, 260],
        "rules_columns": [[58, 506, 340, 112], [462, 506, 326, 112], [850, 506, 350, 112]]
      },
      "text_constraints": {
        "statement_max_chars": 38,
        "rule_max_chars": 90,
        "avoid_list_max_items": 6
      },
      "image_rules": {
        "minimum_px": [1600, 900],
        "crop": "cover",
        "light": "natural warm morning window light",
        "yellow_required": true,
        "hero_elements_max": 3
      },
      "approved_variants": ["hero_top_rules_bottom", "hero_right_rules_left"],
      "overflow": "truncate avoid list only after manual editorial decision; automated population fails",
      "missing_content": "use neutral paper field marked IMAGE REQUIRED; never use generic stock automatically"
    },
    {
      "id": "campaign_territory",
      "required_fields": ["territory_name", "territory_role", "hero_copy", "repeatable_construction", "evidence_label"],
      "optional_fields": ["secondary_copy", "supporting_visual"],
      "geometry_px": {
        "title": [58, 92, 740, 144],
        "hero_execution": [58, 286, 742, 294],
        "mechanism": [858, 286, 326, 331]
      },
      "text_constraints": {
        "territory_name_max_chars": 32,
        "territory_role_max_chars": 110,
        "hero_copy_max_chars": 65,
        "mechanism_steps": 3
      },
      "image_rules": { "required": false, "when_used": "single supporting visual only" },
      "approved_variants": ["yellow_type_led", "paper_image_led"],
      "overflow": "reduce hero copy no lower than 36px; otherwise select another approved copy line",
      "missing_content": "fail when the territory cannot be expressed as one repeatable construction"
    },
    {
      "id": "campaign_executions",
      "required_fields": ["application_1", "application_2", "application_3", "activation_status"],
      "optional_fields": ["channel_note", "operational_disclaimer"],
      "geometry_px": {
        "headline": [58, 86, 1010, 126],
        "application_1": [58, 276, 300, 300],
        "application_2": [390, 276, 300, 300],
        "application_3": [722, 276, 500, 300]
      },
      "text_constraints": {
        "headline_max_chars": 40,
        "intro_max_chars": 125,
        "execution_headline_max_chars": 70,
        "disclaimer_max_chars": 90
      },
      "image_rules": {
        "minimum_px_per_raster_execution": [900, 900],
        "crop": "cover",
        "unverified_operational_detail_must_be_labelled": true
      },
      "approved_variants": ["three_channel_triptych", "one_hero_two_supporting"],
      "overflow": "do not add a fourth execution; create an additional applications page using an approved variant",
      "missing_content": "render missing application as blocked, not as placeholder creative"
    }
  ],
  "visual_qa_checks": [
    "exactly five canonical page types are present in the prototype",
    "all text remains inside the 58px safe area except full-bleed imagery",
    "no body text is below 18px and no label text below 9px",
    "Rave Yellow #FFC700 appears on every page",
    "images are not stretched and follow the specified focal crop",
    "every image has meaningful alt text",
    "unverified claims are labelled source hypothesis or creative illustration",
    "no timestamp, price, performance or quiz state is presented as verified unless sourced",
    "footer and internal/not-client-approved state are visible on every page",
    "speaker notes identify source and evidence status",
    "no overflow, overlap or clipped heading is reported by presentation validation",
    "editable text remains native rather than flattened into a page image"
  ]
}

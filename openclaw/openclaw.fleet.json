{
  "agents": {
    "defaults": {
      "utilityModel": "ollama/qwen3.5:latest",
      "subagents": {
        "requireAgentId": true,
        "maxConcurrent": 4,
        "maxChildrenPerAgent": 4,
        "maxSpawnDepth": 1,
        "archiveAfterMinutes": 1440
      }
    },
    "list": [
      {
        "id": "tony",
        "name": "Tony",
        "model": "anthropic/claude-sonnet-4-6",
        "workspace": "~/.openclaw/workspace-tony",
        "subagents": {
          "delegationMode": "prefer",
          "allowAgents": ["research", "strategy", "creative-director", "production", "operations"],
          "requireAgentId": true
        },
        "tools": {
          "profile": "messaging",
          "alsoAllow": [
            "agents_list",
            "sessions_spawn",
            "sessions_yield",
            "sessions_send",
            "subagents",
            "web_search",
            "web_fetch",
            "narratiive_read_state",
            "narratiive_execute_safe_read",
            "narratiive_request_action_approval",
            "narratiive_manage_attention",
            "narratiive_workflow_control"
          ],
          "deny": ["session_status", "message", "exec", "process", "gateway", "cron", "nodes"]
        }
      },
      {
        "id": "research",
        "name": "Research Agent",
        "model": "anthropic/claude-sonnet-4-6",
        "workspace": "~/.openclaw/workspace-research",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "rw"},
        "tools": {
          "profile": "coding",
          "allow": ["read", "write", "edit", "apply_patch", "browser", "web_search", "web_fetch"],
          "sandbox": {"tools": {"alsoAllow": ["web_search", "web_fetch"]}},
          "deny": ["exec", "process", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      },
      {
        "id": "strategy",
        "name": "Strategy Agent",
        "model": "anthropic/claude-sonnet-4-6",
        "workspace": "~/.openclaw/workspace-strategy",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "rw"},
        "tools": {
          "profile": "coding",
          "allow": ["read", "write", "edit", "apply_patch", "web_fetch"],
          "sandbox": {"tools": {"alsoAllow": ["web_fetch"]}},
          "deny": ["exec", "process", "browser", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      },
      {
        "id": "creative-director",
        "name": "Creative Director Agent",
        "workspace": "~/.openclaw/workspace-creative-director",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "rw"},
        "tools": {
          "profile": "coding",
          "allow": ["read", "write", "edit", "apply_patch", "browser", "web_fetch"],
          "sandbox": {"tools": {"alsoAllow": ["web_fetch"]}},
          "deny": ["exec", "process", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      },
      {
        "id": "production",
        "name": "Production Agent",
        "workspace": "~/.openclaw/workspace-production",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "rw"},
        "tools": {
          "profile": "coding",
          "allow": ["read", "write", "edit", "apply_patch", "web_fetch"],
          "sandbox": {"tools": {"alsoAllow": ["web_fetch"]}},
          "deny": ["exec", "process", "browser", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      },
      {
        "id": "operations",
        "name": "Operations Agent",
        "workspace": "~/.openclaw/workspace-operations",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "ro"},
        "heartbeat": {
          "every": "1h",
          "model": "ollama/qwen3.5:latest",
          "target": "last",
          "lightContext": true,
          "isolatedSession": true,
          "timeoutSeconds": 120,
          "activeHours": {
            "start": "07:00",
            "end": "22:00",
            "timezone": "Europe/London"
          },
          "prompt": "Run Narratiive's read-only proactive Chief of Staff monitor. Inspect persistent OpenClaw specialist assignments with sessions_list and use bounded sessions_history only when the latest evidence or blocker is required. Use narratiive_read_state with view executive_brief and view open_work before deciding whether a material business priority or stalled executive action needs attention; use view current_leads for pipeline claims and view recent_execution before claiming a consequential action happened or worked. Surface a concise alert only for material completed work needing review, stalled/failed/blocked delegated work, an evidence-backed priority, or a concrete founder decision. Never infer status from old chat memory and never claim external execution without returned Narratiive evidence. Do not send messages, spawn or steer agents, make calendar commitments, mutate Notion, or perform any consequential action. If nothing materially needs attention, reply HEARTBEAT_OK."
        },
        "tools": {
          "profile": "coding",
          "allow": ["read", "web_fetch", "agents_list", "sessions_list", "sessions_history", "narratiive_read_state"],
          "sandbox": {"tools": {"alsoAllow": ["web_fetch"]}},
          "deny": ["write", "edit", "apply_patch", "exec", "process", "browser", "message", "gateway", "cron", "nodes", "sessions_spawn", "sessions_send", "subagents"]
        }
      }
    ]
  },
  "tools": {
    "loopDetection": {
      "enabled": true,
      "historySize": 30,
      "warningThreshold": 10,
      "criticalThreshold": 20,
      "unknownToolThreshold": 10,
      "globalCircuitBreakerThreshold": 30,
      "detectors": {
        "genericRepeat": true,
        "knownPollNoProgress": true,
        "pingPong": true
      },
      "postCompactionGuard": {
        "windowSize": 3
      }
    },
    "sessions": {"visibility": "all"},
    "agentToAgent": {
      "enabled": true,
      "allow": ["research", "strategy", "creative-director", "production", "operations"]
    }
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "per-channel-peer",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "62d",
      "maxEntries": 500,
      "resetArchiveRetention": "62d"
    }
  }
}

{
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "subagents": {
        "requireAgentId": true,
        "maxConcurrent": 4,
        "maxChildrenPerAgent": 4,
        "maxSpawnDepth": 1,
        "archiveAfterMinutes": 1440
      }
    },
    "entries": {
      "tony": {
        "workspace": "~/.openclaw/workspace-tony",
        "heartbeat": {
          "every": "1h",
          "target": "last",
          "lightContext": false,
          "isolatedSession": false,
          "timeoutSeconds": 120,
          "activeHours": {
            "start": "07:00",
            "end": "22:00",
            "timezone": "Europe/London"
          },
          "prompt": "Act as Narratiive's proactive Chief of Staff. Inspect live OpenClaw specialist/session state and use Narratiive control-plane read tools when current business truth matters. Check narratiive_executive_brief and narratiive_open_work_status before deciding whether there is a material business priority or stalled executive action; use narratiive_current_leads for pipeline claims and narratiive_recent_execution_status before claiming a consequential action happened or worked. Surface a concise alert only when a specialist has completed material work that needs review, a delegated task is stalled/failed/blocked, an evidence-backed business priority materially needs attention, or there is a concrete next decision for Matt. Never infer status from old chat memory and never claim external execution without returned Narratiive evidence. Do not send messages, make calendar commitments, mutate Notion, or perform other consequential external actions. If nothing materially needs attention, reply HEARTBEAT_OK."
        },
        "subagents": {
          "delegationMode": "prefer",
          "allowAgents": ["research", "strategy", "creative-director", "production", "operations"],
          "requireAgentId": true
        },
        "tools": {
          "allow": ["read", "sessions_list", "sessions_history", "sessions_spawn", "sessions_yield", "subagents", "session_status", "narratiive-control-plane"],
          "deny": ["exec", "process", "gateway", "cron", "nodes"]
        }
      },
      "research": {
        "workspace": "~/.openclaw/workspace-research",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "rw"},
        "tools": {
          "allow": ["read", "write", "edit", "apply_patch", "browser"],
          "deny": ["exec", "process", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      },
      "strategy": {
        "workspace": "~/.openclaw/workspace-strategy",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "rw"},
        "tools": {
          "allow": ["read", "write", "edit", "apply_patch"],
          "deny": ["exec", "process", "browser", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      },
      "creative-director": {
        "workspace": "~/.openclaw/workspace-creative-director",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "rw"},
        "tools": {
          "allow": ["read", "write", "edit", "apply_patch", "browser"],
          "deny": ["exec", "process", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      },
      "production": {
        "workspace": "~/.openclaw/workspace-production",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "rw"},
        "tools": {
          "allow": ["read", "write", "edit", "apply_patch"],
          "deny": ["exec", "process", "browser", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      },
      "operations": {
        "workspace": "~/.openclaw/workspace-operations",
        "sandbox": {"mode": "all", "scope": "agent", "workspaceAccess": "ro"},
        "tools": {
          "allow": ["read"],
          "deny": ["write", "edit", "apply_patch", "exec", "process", "browser", "message", "gateway", "cron", "nodes", "sessions_spawn"]
        }
      }
    }
  },
  "tools": {
    "sessions": {"visibility": "tree"},
    "agentToAgent": {"enabled": false}
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "per-channel-peer",
    "maintenance": {
      "mode": "enforce",
      "pruneAfter": "30d",
      "maxEntries": 500,
      "resetArchiveRetention": "30d"
    }
  }
}
